{
  "manifest_version": 3,
  "name": "Avito CPA Watch",
  "version": "1.3.0",
  "description": "Диагностика динамического CPA-порога Avito в Edge через активную вкладку.",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.avito.ru/*"
  ],
  "action": {
    "default_title": "Avito CPA Watch",
    "default_popup": "popup.html"
  }
}