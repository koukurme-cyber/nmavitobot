{
  "manifest_version": 3,
  "name": "Avito CPA Watch",
  "version": "1.1.0",
  "description": "Следит за динамическим порогом аванса Avito Pro и отправляет тревоги в Telegram.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://www.avito.ru/*",
    "https://api.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.avito.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Avito CPA Watch",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
